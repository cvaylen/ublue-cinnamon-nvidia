
.dialog { color: @FG@; background-color: @DIALOG_BG@; border: 1px solid @DIALOG_BORDER@; border-radius: 4px; padding: 0; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35); }

.dialog .dialog-content-box { margin: 24px 24px 20px 24px; spacing: 32px; max-width: 28em; }

.dialog .dialog-button-box { padding: 12px; border-top: 1px solid @DIALOG_BORDER@; }

.dialog .dialog-button { padding: 7px 20px; border-radius: 3px; color: @FG@; background-color: @BUTTON_BG@; border: 1px solid @BUTTON_BORDER@; }

.dialog .dialog-button:focus { border-color: #5294e2; }

.dialog .dialog-button:hover { background-color: @BUTTON_HOVER_BG@; }

.dialog .dialog-button:active, .dialog .dialog-button:checked { color: #ffffff; background-color: #5294e2; border-color: #5294e2; }

.dialog .dialog-button:insensitive { color: @FG_INSENSITIVE@; background-color: @ENTRY_INSENSITIVE_BG@; border-color: @ENTRY_INSENSITIVE_BORDER@; }

.dialog .dialog-button:default { color: #ffffff; background-color: #5294e2; border-color: #5294e2; }

.dialog .dialog-button:hover:default { background-color: #6ca7e8; border-color: #6ca7e8; }

.dialog .dialog-button:active:default, .dialog .dialog-button:checked:default { background-color: #3d86dd; border-color: #3d86dd; }

.dialog .dialog-button:destructive-action { color: #ffffff; background-color: #F04A50; border-color: #F04A50; }

.dialog .dialog-button:hover:destructive-action { background-color: #f36c71; border-color: #f36c71; }

.dialog .dialog-button:active:destructive-action, .dialog .dialog-button:checked:destructive-action { background-color: #d8353b; border-color: #d8353b; }

.dialog .dialog-button:insensitive:default, .dialog .dialog-button:insensitive:destructive-action { color: @FG_INSENSITIVE@; background-color: @ENTRY_INSENSITIVE_BG@; border-color: @ENTRY_INSENSITIVE_BORDER@; }

.message-dialog-content { spacing: 18px; }

.message-dialog-content .message-dialog-title { text-align: center; font-weight: 800; font-size: 1.364em; }

.message-dialog-content .message-dialog-title.lightweight { font-weight: 700; font-size: 1.182em; }

.message-dialog-content .message-dialog-description { text-align: center; }

.message-dialog-content .message-dialog-caption { text-align: center; font-weight: 400; font-size: 0.818em; color: @FG_DIM@; }

.dialog-list { spacing: 18px; }

.dialog-list .dialog-list-title { text-align: center; font-weight: 700; font-size: 1em; }

.dialog-list .dialog-list-scrollview { max-height: 200px; }

.dialog-list .dialog-list-box { spacing: 1em; }

.dialog-list .dialog-list-box .dialog-list-item { spacing: 1em; }

.dialog-list .dialog-list-box .dialog-list-item .dialog-list-item-title { font-weight: bold; }

.dialog-list .dialog-list-box .dialog-list-item .dialog-list-item-description { font-weight: 400; font-size: 0.818em; color: @FG_DIM@; }

.end-session-dialog { min-width: 40em; }

.end-session-dialog .dialog-content-box { spacing: 0; }

.end-session-dialog .dialog-list { spacing: 0; }

.end-session-dialog .dialog-list .dialog-list-title { color: #F27835; background-color: rgba(242, 120, 53, 0.1); padding: 9px; border-radius: 3px; margin: 4px 0; }

.run-dialog { border-image: none; padding: 0; }

.run-dialog-entry { width: 20em; padding: 7px; border-radius: 3px; caret-color: @FG@; selected-color: #ffffff; selection-background-color: #5294e2; color: @FG@; background-color: @ENTRY_BG@; border: 1px solid @ENTRY_BORDER@; box-shadow: none; }

.run-dialog-entry:focus { color: @FG@; background-color: @ENTRY_BG@; border: 1px solid #5294e2; box-shadow: none; }

.run-dialog-description { text-align: center; padding-top: 0; font-weight: 400; font-size: 0.818em; color: @FG_DIM@; }

.prompt-dialog { width: 26em; }

.prompt-dialog .dialog-content-box { spacing: 16px; }

.prompt-dialog-password-layout { spacing: 8px; }

.prompt-dialog-password-entry { width: 20em; padding: 7px; border-radius: 3px; caret-color: @FG@; selected-color: #ffffff; selection-background-color: #5294e2; color: @FG@; background-color: @ENTRY_BG@; border: 1px solid @ENTRY_BORDER@; }

.prompt-dialog-password-entry:focus { border: 1px solid #5294e2; }

.prompt-dialog-password-entry:insensitive { color: @FG_INSENSITIVE@; background-color: @ENTRY_INSENSITIVE_BG@; border: 1px solid @ENTRY_INSENSITIVE_BORDER@; }

.prompt-dialog-password-entry StLabel.hint-text { color: @FG_INSENSITIVE@; }

.prompt-dialog-password-entry .capslock-warning { icon-size: 16px; warning-color: #F27835; padding: 0 4px; }

.prompt-dialog-password-entry StIcon.peek-password { icon-size: 16px; color: @FG_DIM@; }

.prompt-dialog-error-label, .prompt-dialog-info-label, .prompt-dialog-null-label { text-align: center; font-weight: 400; font-size: 0.818em; }

.prompt-dialog-error-label { color: #FC4138; }

.caps-lock-warning-label { text-align: center; padding-bottom: 8px; font-weight: 400; font-size: 0.818em; color: #F27835; }

.polkit-dialog-user-layout { text-align: center; spacing: 2px; }

.polkit-dialog-user-combo, .audio-device-selection-dialog .audio-selection-box .audio-selection-device { color: @FG@; background-color: @BUTTON_BG@; border: 1px solid @BUTTON_BORDER@; border-radius: 3px; }

.polkit-dialog-user-combo:hover, .audio-device-selection-dialog .audio-selection-box .audio-selection-device:hover { background-color: @BUTTON_HOVER_BG@; }

.polkit-dialog-user-combo:focus, .audio-device-selection-dialog .audio-selection-box .audio-selection-device:focus { border-color: #5294e2; }

.polkit-dialog-user-combo:active, .polkit-dialog-user-combo:checked, .polkit-dialog-user-combo:selected, .audio-device-selection-dialog .audio-selection-box .audio-selection-device:active, .audio-device-selection-dialog .audio-selection-box .audio-selection-device:checked, .audio-device-selection-dialog .audio-selection-box .audio-selection-device:selected { color: #ffffff; background-color: #5294e2; border-color: #5294e2; }

.polkit-dialog-user-combo { padding: 6px 36px; font-weight: 700; font-size: 1em; }

.polkit-dialog-user-combo:insensitive { color: @FG@; }

.audio-device-selection-dialog { min-width: 24em; }

.audio-device-selection-dialog .audio-selection-box { spacing: 12px; }

.audio-device-selection-dialog .audio-selection-box .audio-selection-device .audio-selection-device-box { padding: 12px; spacing: 12px; }

.audio-device-selection-dialog .audio-selection-box .audio-selection-device .audio-selection-device-icon { icon-size: 64px; }

.check-box-2 StBoxLayout { spacing: 0.8em; }

.check-box-2 StBin { width: 16px; height: 16px; background-image: url("@ASSETS@/checkbox/checkbox-unchecked.svg"); }

.check-box-2:focus StBin { background-image: url("@ASSETS@/checkbox/checkbox-unchecked-focused.svg"); }

.check-box-2:checked StBin { background-image: url("@ASSETS@/checkbox/checkbox-checked.svg"); }

.check-box-2:focus:checked StBin { background-image: url("@ASSETS@/checkbox/checkbox-checked-focused.svg"); }

.media-keys-osd, .workspace-switch-osd, .resize-popup { color: #ffffff; background-color: rgba(37, 42, 53, 0.95); border: 1px solid rgba(0, 0, 0, 0.25); border-radius: 5px; text-align: center; }

.media-keys-osd { margin-bottom: 1em; font-weight: bold; font-size: 1.182em; spacing: 12px; padding: 12px 24px; }

.media-keys-osd > * { spacing: 12px; }

.media-keys-osd StIcon { icon-size: 32px; }

.media-keys-osd StLabel:ltr { margin-right: 6px; }

.media-keys-osd StLabel:rtl { margin-left: 6px; }

.media-keys-osd .level { min-width: 160px; -barlevel-height: 6px; -barlevel-background-color: rgba(0, 0, 0, 0.5); -barlevel-active-background-color: #5294e2; -barlevel-amplify-color: #F27835; -barlevel-amplify-separator-width: 3px; }

.media-keys-osd .level:ltr { margin-right: 6px; }

.media-keys-osd .level:rtl { margin-left: 6px; }

.workspace-switch-osd { min-width: 140px; margin-bottom: 1em; font-weight: bold; font-size: 1.182em; padding: 12px 36px 0 36px; }

.workspace-switch-osd-indicator-box { spacing: 12px; }

.workspace-switch-osd-indicator { background-color: rgba(255, 255, 255, 0.5); padding: 2.66667px; margin: 13.33333px; border-radius: 32px; }

.workspace-switch-osd-indicator:active { background-color: #5294e2; padding: 5.33333px; margin: 10.66667px; }

.resize-popup { padding: 12px; }

.grouped-window-list-notifications-badge { border-radius: 99px; background-color: #F04A50; color: #ffffff; }

.grouped-window-list-notifications-badge-label { font-size: 12px; }
